# workflow.env - runtime configuration for the orchestrator scripts.
#
# Dispatch's build-project-base.sh writes the real workflow.env from project.yaml when it
# renders this pack. Every scripts/*.sh sources it, so this file is plain shell: one
# KEY=value per line, and any value containing a space or shell metacharacter MUST be
# double-quoted (for example PROBE_HOSTS="worker=internal:Smoke test"). An unquoted space
# would make bash execute the rest of the line as a command.

# GitHub organisation that owns every repo of this project.
ORG=example-org

# Absolute path of the workspace inside the container. Every repo is a direct child:
# $WORKSPACE/<repo>. The orchestrator repo itself is $WORKSPACE/$ORCHESTRATOR_REPO.
WORKSPACE=/home/agent/example

# Project name (slug). Informational; used in log lines and commit messages.
PROJECT=example

# Name of the deploy workflow file that runs on main in every repo. Merging a PR triggers
# it; merge-fleet.sh waits for it and rollback-fleet.sh waits for the revert's run.
DEPLOY_WORKFLOW=deploy.yml

# Directory name of the orchestrator repo under $WORKSPACE.
ORCHESTRATOR_REPO=orchestrator

# The repo that produces the GraphQL schema the clients consume. Backend-only guards
# (probe.json requirement, schema-change checks, migration race, destructive-DDL refusal)
# apply to this repo. Leave empty if the project has no such repo.
BACKEND_REPO=backend

# Path (inside $BACKEND_REPO) of the committed schema file. When a PR touches it, the
# schema-race guard requires that no other open feature PR also touches it. Optional.
SCHEMA_FILE=

# Path (inside $BACKEND_REPO) of the sequentially numbered migration scripts, for example
# Stamy.Migrations/Modules. Setting it enables the migration-number race guard in
# merge-fleet.sh and the destructive-DDL refusal in rollback-fleet.sh. Leave empty to
# disable both.
MIGRATIONS_DIR=

# Comma-separated check names that must be SUCCESS on every PR in addition to "all checks
# on the head are green". Example: REQUIRED_CHECKS=schema-compat,e2e
REQUIRED_CHECKS=

# Comma-separated repo=host pairs for the production liveness probe, for example
#   PROBE_HOSTS=backend=api.example.com,student=student.example.com,worker=internal:Smoke test
# A host of the form `internal:<step name>` means the repo has no public host and its
# liveness is proven by that named step succeeding in the deploy run of the merged sha.
# If PROBE_HOSTS is empty the probe is skipped entirely (the deploy conclusion is then the
# only evidence, and merge-fleet.sh says so loudly). If it is set, every repo in a fleet
# must have an entry: a slice that cannot be probed cannot be shipped.
PROBE_HOSTS=

# Comma-separated extra workflows on main that must be idle before merging into
# $BACKEND_REPO (for example a schema-compat validator that also runs on main). Optional.
EXTRA_MAIN_WORKFLOWS=

# Timeouts in seconds.
DEPLOY_TIMEOUT=2400
IDLE_TIMEOUT=1800
CI_TIMEOUT=2400
